# Copy to .env for local development. NEVER commit the real .env.

# Database. Leave unset to use embedded PGlite at ./data/pgdata (local only).
# DATABASE_URL=postgresql://user:password@host:5432/gni

# Public origin, used for canonical URLs and sitemap.xml
PUBLIC_BASE_URL=http://localhost:3000

# Salt for view-session hashing. Generate with: openssl rand -hex 32
VIEW_SALT=change-me

# Bearer token protecting /api/admin/*. Generate with: openssl rand -hex 32
# If unset, the whole admin API returns 503 (secure by default).
ADMIN_TOKEN=

# Token do endpoint de cron externo: POST /api/cron/run com header x-cron-token.
# Se não for definido, o endpoint devolve 503 (seguro por omissão).
# Gerar com: openssl rand -hex 32
CRON_TOKEN=

# Pipeline
CYCLE_MINUTES=10
RUN_WORKER_IN_WEB=true
FETCH_TIMEOUT_MS=15000
CLUSTER_SIM=0.30
CLUSTER_WINDOW_H=48

# Anti-manipulation
VIEW_DEDUPE_MIN=30
VIEW_RATE_HOUR=60

# ---- Support / donations (§83) ----
# Optional. Defaults are the operator's real, verified details.
# The Ethereum address is validated against its EIP-55 checksum before being
# displayed; an address failing the check is refused rather than shown.
# SUPPORT_REVOLUT=infowithgoal
# SUPPORT_ETH=0x558d60469aC85EBC9679aB67835Fa9657a4B469e

# ---- LLM specialist agents (§9, §67) ----
# Optional. With no key set, LLM agents report UNAVAILABLE and the deterministic
# pipeline runs unchanged — nothing is ever guessed to fill the gap.
# Every LLM-extracted claim must quote its source article verbatim or it is
# discarded; if under half verify, the whole response is rejected.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_MAX_CALLS_PER_CYCLE=50
# LLM_TIMEOUT_MS=30000
